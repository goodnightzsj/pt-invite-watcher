{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PT Invite Watcher",
  "version": "0.1.2",
  "identifier": "com.pt-invite-watcher.app",
  "build": {
    "beforeDevCommand": "npm --prefix webui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix webui run build",
    "frontendDist": "../pt_invite_watcher/webui_dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PT Invite Watcher",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http: ws: wss:; img-src 'self' https: http: data:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/goodnightzsj/pt-invite-watcher/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBKEY"
    }
  }
}
