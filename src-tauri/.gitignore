# Generated by Cargo
/target/

# Per-target bundled sidecar binaries, produced by `scripts/build-sidecar/build.py`.
# They're large and platform-specific; build on each CI runner instead of committing.
/binaries/

# Generated by `tauri android init` / `tauri ios init`.
