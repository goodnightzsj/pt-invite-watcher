{
  "name": "pt-invite-watcher-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrapper that ships the PT Invite Watcher web UI as a native Android / iOS app.",
  "scripts": {
    "prebuild": "npm --prefix ../webui run build",
    "sync": "cap sync",
    "android:init": "cap add android",
    "ios:init": "cap add ios",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
