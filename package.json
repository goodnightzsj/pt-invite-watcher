{
  "name": "pt-invite-watcher-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Native desktop + mobile shell for PT Invite Watcher (Tauri 2).",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "webui:dev": "npm --prefix webui run dev",
    "webui:build": "npm --prefix webui run build",
    "sidecar:build": ".venv/bin/python scripts/build-sidecar/build.py",
    "mobile:android:init": "npm --prefix mobile run android:init",
    "mobile:android:open": "npm --prefix mobile run android:open",
    "mobile:ios:init": "npm --prefix mobile run ios:init",
    "mobile:ios:open": "npm --prefix mobile run ios:open",
    "mobile:sync": "npm --prefix mobile run sync"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
